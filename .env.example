# Copy this file to .env and set your Supabase PostgreSQL connection string.
# The app will load this automatically for local runs.
DB_URL=postgresql://user:password@host:5432/postgres

# Optional aliases supported by the app:
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres
